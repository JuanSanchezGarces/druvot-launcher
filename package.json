{
  "name": "druvot-launcher",
  "version": "1.0.0",
  "description": "Launcher oficial do servidor Druvot",
  "author": "JuanSanchezGarces",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --publish never",
    "generate-manifest": "node scripts/generate-manifest.js"
  },
  "dependencies": {
    "extract-zip": "^2.0.1"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^25.0.0",
    "png-to-ico": "^3.0.1"
  },
  "build": {
    "appId": "com.druvot.launcher",
    "productName": "Druvot Launcher",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "druvot_launcher.exe"
    }
  }
}
